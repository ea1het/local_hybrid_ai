# Pinned Open WebUI image. Never use latest/main/dev in a managed deployment.
# Used by: Stack7 prepare + Compose.
# Secret: no. Lifecycle: configurable; version pin is mandatory.
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui
OPENWEBUI_VERSION=v0.11.4

# OpenAI-compatible model gateway provided by Stack3/LiteLLM.
# OPENWEBUI_LITELLM_API_KEY must be a dedicated least-privilege inference key;
# do not reuse LITELLM_MASTER_KEY or the Hermes LITELLM_API_KEY.
# Used by: Stack7 Compose/Open WebUI bootstrap.
# Secret: API key yes; base URL no.
# Lifecycle: base URL fixed-default; create a dedicated inference key in
# LiteLLM or restore one with database state, then place it in .env.
OPENWEBUI_LITELLM_BASE_URL=http://litellm:4000/v1
OPENWEBUI_LITELLM_API_KEY=PUT_YOUR_OPENWEBUI_LITELLM_API_KEY_HERE

# Persistent Open WebUI signing/session identity. Changing it after users/state
# exist may invalidate sessions or encrypted application state.
# Used by: Stack7 Compose/Open WebUI runtime.
# Secret: yes. Lifecycle: generated-once/persistent-secret; never rotate implicitly.
OPENWEBUI_SECRET_KEY=PUT_YOUR_OPENWEBUI_SECRET_KEY_HERE
