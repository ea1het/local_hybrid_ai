# =============================================================================
# Local Hybrid AI - Central deployment environment template
# =============================================================================
#
# PURPOSE
# -------
# This is the single documented variable contract for the complete platform
# deployment. The operational file is /opt/docker/stacks/.env and MUST NOT be
# committed. Run ./local-ai env bootstrap to generate locally controlled
# secrets; externally issued credentials remain operator-supplied.
#
# Each application stack keeps a local .env symlink pointing to ../.env so the
# existing manual stack workflow continues to work unchanged.
#
# OPERATIONAL MODEL
# -----------------
#   /opt/docker/stacks/.env              real deployment values, root:root 0600
#   /opt/docker/stacks/.env.template     this Git-tracked reference template
#   stack-10_-_haproxy_web/.env         -> ../.env
#   stack-20_-_searxng_firecrawl/.env   -> ../.env
#   stack-30_-_litellm/.env             -> ../.env
#   stack-40_-_gitea/.env               -> ../.env
#   stack-50_-_dockhand/.env            -> ../.env
#   stack-60_-_hermes/.env              -> ../.env
#   stack-70_-_open-webui/.env          -> ../.env
#
# Stack0 owns the platform bootstrap and creates/validates these compatibility
# symlinks. Stack0 itself reads the root operational .env directly.
#
# DOCUMENTATION CONVENTIONS
# -------------------------
# Used by:     scripts/services that consume the variable today.
# Secret:      whether the value must be treated as sensitive.
# Lifecycle:   how the value should be managed over time.
#
# Lifecycle vocabulary used here:
#   fixed-default       safe deployment default unless deliberately changed
#   configurable        operator-selected non-secret configuration
#   generated-once      secret/identity value that may be generated initially
#                       but must then be preserved and never rotated implicitly
#   operator-supplied   value obtained from an external system/operator
#   persistent-secret   existing secret that must survive reinstalls/upgrades
#   optional            may intentionally be empty or unused
#
# IMPORTANT
# ---------
# Variables are grouped by ownership/consumer boundary so deployment automation
# can reason about each stack without introducing cross-stack state ownership.
# =============================================================================


# =============================================================================
# 00 - PLATFORM / SHARED DEPLOYMENT CONTEXT
# =============================================================================
# Consumed by Stack0 and the application stacks. These variables define the
# source/runtime filesystem contract and the shared Docker network.
# -----------------------------------------------------------------------------

# Git-managed source worktree.
# Used by: Stack0 and Stack1-Stack7 prepare/provision scripts.
# Secret: no. Lifecycle: fixed-default.
STACKS_ROOT=/opt/docker/stacks

# Persistent mutable application/runtime state.
# Used by: Stack0, Stack1-Stack7 scripts and Compose bind mounts.
# Secret: no. Lifecycle: fixed-default.
BASE_PATH=/opt/docker/runtime

# Shared infrastructure Docker network.
# Created/validated by: Stack0. Consumed by application stacks as required.
# Secret: no. Lifecycle: configurable/fixed-default.
NETWORK_NAME=redlocal

# Numeric group for read access to the HAProxy TLS private key.
# Stack0 00-bootstrap.py creates local-hybrid-pki with this GID and
# install-tls-certs.py installs tls.key as root:<GID> 0640; Stack1 validation
# and Compose add the same supplementary group. Existing group/GID conflicts
# fail closed.
# Secret: no. Lifecycle: persistent configuration; coordinate changes with consumers.
PLATFORM_PKI_GID=1999

# Root internal DNS domain of the platform.
# Used by: Stack1 (HAProxy routing, compose, prepare).
# Secret: no. Lifecycle: configurable.
ROOT_HOSTNAME=casa.lan

# The internal hostname of the platform root node. This is the host name
# used by the HAProxy TLS certificate and the mkcert CA. It is also used by
# Stack1 to construct the PROXY_BASE_URL for Stack3/LiteLLM. It must be 
# resolvable by all stacks and the host.
# Used by: Stack1 (HAProxy routing, compose, prepare), Stack3 (LiteLLM PROXY_BASE_URL).
# Secret: no. Lifecycle: configurable.
GWIA_ROOT_EXTERNAL_HOSTNAME=jonathangf.com

# File name (without extension) under which the mkcert CA (rootCA.pem) is
# installed in the host trust store: /usr/local/share/ca-certificates/<name>.crt
# (directory and .crt suffix are imposed by update-ca-certificates).
# Used by: Stack0 install-ca-cert.py (install), install-tls-certs.py (chain
# validation) and verify.py.
# Secret: no. Lifecycle: configurable; changing it later leaves the old file
# installed until removed by hand.
LOCAL_CA_NAME=casa-local-ca

# Source certificates copied from mkcert to the stacks server before Stack 00
# install. These absolute paths are read only when the installed CA or TLS pair
# is missing, invalid, or explicitly rotated. Keep the private key protected.
# Used by: Stack0 install-ca-cert.py and install-tls-certs.py.
# Secret: only TLS_KEY_SOURCE_PATH names private material; the path itself is
# not a secret. Lifecycle: configurable.
LOCAL_CA_SOURCE_PATH=/tmp/rootCA.pem
TLS_CERT_SOURCE_PATH=/tmp/tls.crt
TLS_KEY_SOURCE_PATH=/tmp/tls.key

# DNS names the HAProxy TLS certificate (tls.crt, issued by the mkcert CA) must
# contain in its subjectAltName. Space- or comma-separated; quote the value.
# Keep it in sync with the names passed to mkcert when issuing the certificate.
# Used by: Stack0 install-tls-certs.py (refuses a certificate missing any of
# them) and verify.py.
# Secret: no. Lifecycle: configurable.
TLS_SAN_DOMAINS="casa.lan *.casa.lan"


# =============================================================================
# 10 - STACK10 / HAProxy + static web
# =============================================================================
# Shared variables additionally used: STACKS_ROOT, BASE_PATH, NETWORK_NAME,
# ROOT_HOSTNAME, PLATFORM_PKI_GID
# Primary consumers: stack-10 01-prepare.py, docker-compose.yml, HAProxy config.
# -----------------------------------------------------------------------------

# Pinned HAProxy image repository and version.
# Used by: Stack1 prepare + Compose.
# Secret: no. Lifecycle: configurable; never use latest.
HAPROXY_IMAGE=haproxy
HAPROXY_VERSION=3.4.4-alpine3.24

# Host ports published by HAProxy.
# Used by: Stack1 docker-compose.yml / prepare validation.
# Secret: no. Lifecycle: configurable.
HAPROXY_HTTP_PORT=80
HAPROXY_HTTPS_PORT=443

# Static root web backend.
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: fixed-default.
WEB_TARGET=web:80

# Search route -> SearXNG (Stack2).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
SEARCH_HOSTNAME=buscar
SEARCH_TARGET=searxng:8080

# Optional chat route -> Open WebUI (Stack7).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: optional.
CHAT_HOSTNAME=chat
CHAT_TARGET=open-webui:8080

# Git route -> Gitea (Stack4).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
GIT_HOSTNAME=git
GIT_TARGET=gitea:3000

# AI gateway route -> LiteLLM (Stack3).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
GWIA_HOSTNAME=gwia
GWIA_TARGET=litellm:4000

# Homelab route -> Dockhand (Stack5).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
HOMELAB_HOSTNAME=homelab
HOMELAB_TARGET=dockhand:3000

# NorAI route -> Hermes dashboard (Stack6).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
NORAI_HOSTNAME=norai
NORAI_TARGET=hermes:9119


# =============================================================================
# 20 - STACK20 / SearXNG + Firecrawl
# =============================================================================
# Shared variables additionally used: STACKS_ROOT, BASE_PATH, NETWORK_NAME
# Primary consumers: stack-20 01-prepare.py, wait-ready.py and docker-compose.yml.
# Stack2 owns all of its database state; Stack3 no longer consumes it.
# PostgreSQL admin credentials are deliberately NOT part of this shared env.
# -----------------------------------------------------------------------------

# Pinned images. Digest-pinned references are intentional; never use latest.
# Used by: Stack2 Compose.
# Secret: no. Lifecycle: configurable.
SEARXNG_IMAGE=searxng/searxng:2026.9.23-3cd69d30e
FIRECRAWL_IMAGE=ghcr.io/firecrawl/firecrawl:2.11.399
# Manual update only
FIRECRAWL_PLAYWRIGHT_IMAGE=ghcr.io/firecrawl/playwright-service@sha256:df1a393ce8bfc3801570a826a9b0dcc400ae48789adb4a0ad9d6cbf0229b059b
# Manual update only
FIRECRAWL_POSTGRES_IMAGE=ghcr.io/firecrawl/nuq-postgres@sha256:9b638af78d99873bc0ba2b57c9cbcd01df6ce96efeaa72d36cfbe0f76521e8fc
FIRECRAWL_REDIS_IMAGE=redis
FIRECRAWL_REDIS_VERSION=8.10.2-alpine3.23
FIRECRAWL_RABBITMQ_IMAGE=rabbitmq
FIRECRAWL_RABBITMQ_VERSION=3.13.7-alpine

# Seconds wait-ready.py waits for Stack2 readiness.
# Used by: Stack2 wait-ready.py. Optional: defaults to 90 when unset.
# Secret: no. Lifecycle: configurable/optional.
STACK2_READY_TIMEOUT_SECONDS=90

# Local search/scrape backends published on redlocal for other stacks.
# Consumed by: Stack6 (Hermes web tools) and Stack7 (Open WebUI web search).
# FIRECRAWL_API_KEY is intentionally empty in the current local deployment
# because Firecrawl authentication is disabled.
# Secret: FIRECRAWL_API_KEY only if enabled in a future deployment.
# Lifecycle: URLs fixed-default; key optional.
SEARXNG_URL=http://searxng:8080
FIRECRAWL_API_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=

# SearXNG application secret.
# Used by: Stack2 prepare + SearXNG runtime.
# Secret: yes. Lifecycle: generated-once.
SEARXNG_SECRET=PUT_YOUR_SECRET_HERE

# Public SearXNG URL terminated by Stack1/HAProxy.
# Used by: Stack2 prepare + SearXNG runtime.
# Secret: no. Lifecycle: configurable.
SEARXNG_BASE_URL=https://buscar.casa.lan/

# Redis password protecting Firecrawl's internal Redis on shared redlocal.
# Used by: Stack2 Compose / Firecrawl + Redis.
# Secret: yes. Lifecycle: generated-once.
REDIS_PASSWORD=PUT_YOUR_PASSWORD_HERE

# RabbitMQ credentials for Firecrawl/NuQ.
# Used by: Stack2 Compose / Firecrawl + RabbitMQ.
# Secret: RABBITMQ_PASSWORD yes; RABBITMQ_USER no.
# Lifecycle: user configurable, password generated-once.
RABBITMQ_USER=firecrawl
RABBITMQ_PASSWORD=PUT_YOUR_PASSWORD_HERE

# Dedicated Firecrawl application database identity.
# The PostgreSQL administrative role remains postgres. Its canonical password
# is supplied from the protected root .env to PostgreSQL by Compose.
# Firecrawl itself must never use the postgres administrative role.
# NUQ/pg_cron are intentionally kept in the postgres database.
# Secret: FIRECRAWL_DB_PASSWORD yes; name/user no.
# Lifecycle: app user/name fixed by stack contract, password generated-once.
FIRECRAWL_DB_NAME=postgres
FIRECRAWL_DB_USER=firecrawl
FIRECRAWL_DB_PASSWORD=PUT_YOUR_PASSWORD_HERE
FIRECRAWL_POSTGRES_ADMIN_PASSWORD=PUT_YOUR_PASSWORD_HERE


# =============================================================================
# 30 - STACK30 / LiteLLM + dedicated PostgreSQL
# =============================================================================
# Shared variables additionally used: STACKS_ROOT, BASE_PATH, NETWORK_NAME
# Primary consumers: stack-30 01-prepare.py, provision-postgres.py,
# docker-compose.yml and LiteLLM runtime.
# Stack3 owns both LiteLLM and litellm-postgres.
# -----------------------------------------------------------------------------

# Pinned LiteLLM image repository and version.
# Used by: Stack3 prepare + Compose.
# Secret: no. Lifecycle: configurable; never use latest.
LITELLM_IMAGE=ghcr.io/berriai/litellm-database
LITELLM_VERSION=1.102.1

# LiteLLM administrative master key.
# Used by: Stack3 prepare + LiteLLM runtime.
# Secret: yes. Lifecycle: generated-once/persistent-secret.
LITELLM_MASTER_KEY=PUT_YOUR_MASTER_KEY_HERE

# LiteLLM encryption salt. Once encrypted DB state exists, changing this can
# make stored encrypted values unusable.
# Used by: Stack3 prepare + LiteLLM runtime.
# Secret: yes. Lifecycle: generated-once; NEVER rotate implicitly.
LITELLM_SALT_KEY=PUT_YOUR_SALT_KEY_HERE

# LiteLLM Admin UI credentials.
# Used by: Stack3 prepare + LiteLLM runtime.
# Secret: UI_PASSWORD yes; UI_USERNAME no.
# Lifecycle: username configurable, password generated-once.
UI_USERNAME=admin
UI_PASSWORD=PUT_YOUR_PASSWORD_HERE

# Persist dynamically managed model configuration in PostgreSQL.
# Used by: Stack3 prepare + LiteLLM runtime.
# Secret: no. Lifecycle: fixed-default.
STORE_MODEL_IN_DB=True

# Dedicated LiteLLM application database identity in Stack3 PostgreSQL.
# The PostgreSQL administrative password is generated in .env by
# ./local-ai env bootstrap; no runtime password file is created or mounted.
# Host/port are internal Stack3 defaults: litellm-postgres:5432.
# Secret: LITELLM_DB_PASSWORD yes; name/user no.
# Lifecycle: DB/user configurable, password generated-once.
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=PUT_YOUR_PASSWORD_HERE
LITELLM_POSTGRES_ADMIN_PASSWORD=PUT_YOUR_PASSWORD_HERE

# Stack3 PostgreSQL image and internal endpoint used by LiteLLM.
# Used by: Stack3 Compose + prepare/postgres scripts.
# Secret: no. Lifecycle: PostgreSQL 18 image version-pinned, never latest;
# host/port fixed-default.
LITELLM_POSTGRES_IMAGE=postgres:18.6-alpine3.24
LITELLM_POSTGRES_HOST=litellm-postgres
LITELLM_POSTGRES_PORT=5432


# =============================================================================
# 40 - STACK40 / Gitea + runner
# =============================================================================
# Shared variables additionally used: STACKS_ROOT, BASE_PATH, NETWORK_NAME
# Also read by Stack6 (reconcile-capabilities.py): GITEA_CONTAINER_NAME.
# Primary consumers: stack-40 01-prepare.py, deploy-gitea.py and docker-compose.yml.
# -----------------------------------------------------------------------------

# Pinned Gitea image and container/runtime identity.
# Used by: Stack4 prepare + Compose.
# Secret: no. Lifecycle: configurable/persistent.
GITEA_IMAGE=docker.gitea.com/gitea:1.27.3-rootless
GITEA_CONTAINER_NAME=gitea
GITEA_UID=1000
GITEA_GID=1000

# Host SSH publication and shared Docker network.
# Used by: Stack4 prepare + Compose.
# Secret: no. Lifecycle: configurable.
GITEA_SSH_BIND=0.0.0.0
GITEA_SSH_PORT=2222
GITEA_DOCKER_NETWORK=redlocal

# Public/internal identity of the Gitea service.
# Used by: Stack4 prepare/rendering and Gitea runtime.
# Secret: no. Lifecycle: configurable.
GITEA_DOMAIN=git.casa.lan
GITEA_ROOT_URL=https://git.casa.lan/
GITEA_SSH_DOMAIN=git.casa.lan
GITEA_TIMEZONE=Europe/Madrid

# Existing Gitea internal/JWT secrets.
# Used by: Stack4 prepare rendering + Gitea runtime.
# Secret: yes. Lifecycle: persistent-secret; NEVER rotate implicitly.
GITEA_INTERNAL_TOKEN=PUT_YOUR_INTERNAL_TOKEN_HERE
GITEA_JWT_SECRET=PUT_YOUR_JWT_SECRET_HERE

# Bootstrap administrator identity.
# Used by: Stack4 01-prepare.py validation + deploy-gitea.py user creation.
# Secret: GITEA_ADMIN_PASSWORD yes; username/email no.
# Lifecycle: identity configurable; password operator-supplied/generated-once.
GITEA_ADMIN_USERNAME=ea1het
GITEA_ADMIN_EMAIL=ea1het@ea1het.com
GITEA_ADMIN_PASSWORD=PUT_YOUR_ADMIN_PASSWORD_HERE

# Gitea Actions runner configuration.
# The runner image is project-managed source state, pinned exactly in Stack4
# Compose and classified as a local component by Stack4 manifest.json. It is
# deliberately not an operational .env version authority.
# The registration token itself is persistent runtime state owned by Stack4 at:
#   ${BASE_PATH}/service_-_gitea-runner/secret/registration-token
# Existing deployments may adopt the former token value once during preparation;
# fresh deployments generate the secret once and preserve it outside .env.
# Secret: none of the values below. Lifecycle: configurable/fixed-default.
GITEA_RUNNER_NAME=runner-standalone
GITEA_RUNNER_INSTANCE_URL=http://gitea:3000/

# One-time adoption of a pre-existing runner registration token. Leave empty on
# fresh deployments (Stack4 generates and preserves its own token).
# Used by: Stack4 01-prepare.py.
# Secret: yes. Lifecycle: operator-supplied/optional.
GITEA_RUNNER_REGISTRATION_TOKEN=


