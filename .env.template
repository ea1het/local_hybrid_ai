# =============================================================================
# Local Hybrid AI - Central deployment environment template
# =============================================================================
#
# PURPOSE
# -------
# This is the single documented variable contract for the complete platform
# deployment. The operational file is /opt/docker/stacks/.env and MUST NOT be
# committed. Each application stack keeps a local .env symlink pointing to
# ../.env so the existing manual stack workflow continues to work unchanged.
#
# OPERATIONAL MODEL
# -----------------
#   /opt/docker/stacks/.env              real deployment values, root:root 0600
#   /opt/docker/stacks/.env.template     this Git-tracked reference template
#   stack1_-_haproxy_web/.env         -> ../.env
#   stack2_-_searxng_firecrawl/.env   -> ../.env
#   stack3_-_litellm/.env             -> ../.env
#   stack4_-_gitea/.env               -> ../.env
#   stack5_-_dockhand/.env            -> ../.env
#   stack6_-_hermes/.env              -> ../.env
#
# Stack0 owns the platform bootstrap and creates/validates these compatibility
# symlinks. Stack0 itself reads the root operational .env directly.
#
# DOCUMENTATION CONVENTIONS
# -------------------------
# Used by:     scripts/services that consume the variable today.
# Secret:      whether the value must be treated as sensitive.
# Lifecycle:   how the value should be managed over time.
#
# Lifecycle vocabulary used here:
#   fixed-default       safe deployment default unless deliberately changed
#   configurable        operator-selected non-secret configuration
#   generated-once      secret/identity value that may be generated initially
#                       but must then be preserved and never rotated implicitly
#   operator-supplied   value obtained from an external system/operator
#   persistent-secret   existing secret that must survive reinstalls/upgrades
#   optional            may intentionally be empty or unused
#
# IMPORTANT
# ---------
# Variables are grouped by ownership/consumer boundary so deployment automation
# can reason about each stack without introducing cross-stack state ownership.
# =============================================================================


# =============================================================================
# 00 - PLATFORM / SHARED DEPLOYMENT CONTEXT
# =============================================================================
# Consumed by Stack0 and the application stacks. These variables define the
# source/runtime filesystem contract and the shared Docker network.
# -----------------------------------------------------------------------------

# Git-managed source worktree.
# Used by: Stack0 and Stack1-Stack6 prepare/provision scripts.
# Secret: no. Lifecycle: fixed-default.
STACKS_ROOT=/opt/docker/stacks

# Persistent mutable application/runtime state.
# Used by: Stack0, Stack1-Stack6 scripts and Compose bind mounts.
# Secret: no. Lifecycle: fixed-default.
BASE_PATH=/opt/docker/runtime

# Shared infrastructure Docker network.
# Created/validated by: Stack0. Consumed by application stacks as required.
# Secret: no. Lifecycle: configurable/fixed-default.
NETWORK_NAME=redlocal

# Numeric group for read access to Stack0 PKI by approved consumers.
# Stack0 creates local-hybrid-pki with this GID; Stack1 validation and Compose
# add the same supplementary group. Existing group/GID conflicts fail closed.
# Secret: no. Lifecycle: persistent configuration; coordinate changes with consumers.
PLATFORM_PKI_GID=1999


# =============================================================================
# 01 - STACK1 / HAProxy + static web
# =============================================================================
# Shared variables additionally used: STACKS_ROOT, BASE_PATH
# Primary consumers: stack1 01-prepare.sh, docker-compose.yml, HAProxy config.
# -----------------------------------------------------------------------------

# Host ports published by HAProxy.
# Used by: Stack1 docker-compose.yml / prepare validation.
# Secret: no. Lifecycle: configurable.
HAPROXY_HTTP_PORT=80
HAPROXY_HTTPS_PORT=443

# Root internal DNS domain served by HAProxy.
# Used by: Stack1 prepare + HAProxy routing.
# Secret: no. Lifecycle: configurable.
ROOT_HOSTNAME=casa.lan

# Static root web backend.
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: fixed-default.
WEB_TARGET=web:80

# Search route -> SearXNG (Stack2).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
SEARCH_HOSTNAME=buscar
SEARCH_TARGET=searxng:8080

# Optional chat route -> Open WebUI if deployed separately.
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: optional.
CHAT_HOSTNAME=chat
CHAT_TARGET=open-webui:8080

# Git route -> Gitea (Stack4).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
GIT_HOSTNAME=git
GIT_TARGET=gitea:3000

# AI gateway route -> LiteLLM (Stack3).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
GWIA_HOSTNAME=gwia
GWIA_TARGET=litellm:4000

# Homelab route -> Dockhand (Stack5).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
HOMELAB_HOSTNAME=homelab
HOMELAB_TARGET=dockhand:3000

# Agent route -> Hermes dashboard (Stack6).
# Used by: Stack1 prepare + HAProxy runtime.
# Secret: no. Lifecycle: configurable/fixed target.
AGENTIA_HOSTNAME=agentia
AGENTIA_TARGET=hermes:9119


# =============================================================================
# 02 - STACK2 / SearXNG + Firecrawl
# =============================================================================
# Shared variables additionally used: STACKS_ROOT, BASE_PATH, NETWORK_NAME
# Primary consumers: stack2 01-prepare.sh and docker-compose.yml.
# Stack2 owns all of its database state; Stack3 no longer consumes it.
# -----------------------------------------------------------------------------

# SearXNG application secret.
# Used by: Stack2 prepare + SearXNG runtime.
# Secret: yes. Lifecycle: generated-once.
SEARXNG_SECRET=PUT_YOUR_SECRET_HERE

# Public SearXNG URL terminated by Stack1/HAProxy.
# Used by: Stack2 prepare + SearXNG runtime.
# Secret: no. Lifecycle: configurable.
SEARXNG_BASE_URL=https://buscar.casa.lan/

# Redis password protecting Firecrawl's internal Redis on shared redlocal.
# Used by: Stack2 Compose / Firecrawl + Redis.
# Secret: yes. Lifecycle: generated-once.
REDIS_PASSWORD=PUT_YOUR_PASSWORD_HERE

# RabbitMQ credentials for Firecrawl/NuQ.
# Used by: Stack2 Compose / Firecrawl + RabbitMQ.
# Secret: RABBITMQ_PASSWORD yes; RABBITMQ_USER no.
# Lifecycle: user configurable, password generated-once.
RABBITMQ_USER=firecrawl
RABBITMQ_PASSWORD=PUT_YOUR_PASSWORD_HERE

# PostgreSQL administrative identity owned exclusively by Stack2.
# Used by: Stack2 Firecrawl PostgreSQL runtime.
# Secret: POSTGRES_PASSWORD yes; user/db no.
# Lifecycle: identity configurable, password generated-once.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PUT_YOUR_PASSWORD_HERE
POSTGRES_DB=postgres


# =============================================================================
# 03 - STACK3 / LiteLLM + dedicated PostgreSQL
# =============================================================================
# Shared variables additionally used: STACKS_ROOT, BASE_PATH, NETWORK_NAME
# Primary consumers: stack3 01-prepare.sh, 02-postgres.sh,
# docker-compose.yml and LiteLLM runtime.
# Stack3 owns both LiteLLM and litellm-postgres.
# -----------------------------------------------------------------------------

# Pinned LiteLLM image repository and version.
# Used by: Stack3 prepare + Compose.
# Secret: no. Lifecycle: configurable; never use latest.
LITELLM_IMAGE=ghcr.io/berriai/litellm-database
LITELLM_VERSION=1.99.1

# LiteLLM administrative master key.
# Used by: Stack3 prepare + LiteLLM runtime.
# Secret: yes. Lifecycle: generated-once/persistent-secret.
LITELLM_MASTER_KEY=PUT_YOUR_MASTER_KEY_HERE

# LiteLLM encryption salt. Once encrypted DB state exists, changing this can
# make stored encrypted values unusable.
# Used by: Stack3 prepare + LiteLLM runtime.
# Secret: yes. Lifecycle: generated-once; NEVER rotate implicitly.
LITELLM_SALT_KEY=PUT_YOUR_SALT_KEY_HERE

# LiteLLM Admin UI credentials.
# Used by: Stack3 prepare + LiteLLM runtime.
# Secret: UI_PASSWORD yes; UI_USERNAME no.
# Lifecycle: username configurable, password generated-once.
UI_USERNAME=admin
UI_PASSWORD=PUT_YOUR_PASSWORD_HERE

# Persist dynamically managed model configuration in PostgreSQL.
# Used by: Stack3 prepare + LiteLLM runtime.
# Secret: no. Lifecycle: fixed-default.
STORE_MODEL_IN_DB=True

# Dedicated LiteLLM application database identity in Stack3 PostgreSQL.
# The PostgreSQL administrative secret is generated once by Stack3 under
# ${BASE_PATH}/service_-_litellm-postgres/secret and is not stored in .env.
# Host/port are internal Stack3 defaults: litellm-postgres:5432.
# Secret: LITELLM_DB_PASSWORD yes; name/user no.
# Lifecycle: DB/user configurable, password generated-once.
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=PUT_YOUR_PASSWORD_HERE


# =============================================================================
# 04 - STACK4 / Gitea + runner
# =============================================================================
# Shared variables additionally used: STACKS_ROOT, BASE_PATH
# Primary consumers: stack4 01-prepare.sh, 02-run.sh and docker-compose.yml.
# -----------------------------------------------------------------------------

# Pinned Gitea image and container/runtime identity.
# Used by: Stack4 prepare + Compose.
# Secret: no. Lifecycle: configurable/persistent.
GITEA_IMAGE=docker.gitea.com/gitea:1.27.1-rootless
GITEA_CONTAINER_NAME=gitea
GITEA_UID=1000
GITEA_GID=1000

# Host SSH publication and shared Docker network.
# Used by: Stack4 prepare + Compose.
# Secret: no. Lifecycle: configurable.
GITEA_SSH_BIND=0.0.0.0
GITEA_SSH_PORT=2222
GITEA_DOCKER_NETWORK=redlocal

# Public/internal identity of the Gitea service.
# Used by: Stack4 prepare/rendering and Gitea runtime.
# Secret: no. Lifecycle: configurable.
GITEA_DOMAIN=git.casa.lan
GITEA_ROOT_URL=https://git.casa.lan/
GITEA_SSH_DOMAIN=git.casa.lan
GITEA_TIMEZONE=Europe/Madrid

# Existing Gitea internal/JWT secrets.
# Used by: Stack4 prepare rendering + Gitea runtime.
# Secret: yes. Lifecycle: persistent-secret; NEVER rotate implicitly.
GITEA_INTERNAL_TOKEN=PUT_YOUR_INTERNAL_TOKEN_HERE
GITEA_JWT_SECRET=PUT_YOUR_JWT_SECRET_HERE

# Bootstrap administrator identity.
# Used by: Stack4 01-prepare.sh validation + 02-run.sh user creation.
# Secret: GITEA_ADMIN_PASSWORD yes; username/email no.
# Lifecycle: identity configurable; password operator-supplied/generated-once.
GITEA_ADMIN_USERNAME=ea1het
GITEA_ADMIN_EMAIL=ea1het@ea1het.com
GITEA_ADMIN_PASSWORD=PUT_YOUR_ADMIN_PASSWORD_HERE

# Gitea Actions runner configuration.
# The registration token itself is persistent runtime state owned by Stack4 at:
#   ${BASE_PATH}/service_-_gitea-runner/secret/registration-token
# Existing deployments may adopt the former .env value once during preparation;
# fresh deployments generate the secret once and preserve it outside .env.
# Secret: none of the values below. Lifecycle: configurable/fixed-default.
GITEA_RUNNER_IMAGE=docker.io/gitea/runner:3
GITEA_RUNNER_NAME=runner-standalone
GITEA_RUNNER_INSTANCE_URL=http://gitea:3000/


# =============================================================================
# 05 - STACK5 / Dockhand
# =============================================================================
# Stack5 intentionally owns no additional application-specific variables today.
# It consumes only the shared STACKS_ROOT and BASE_PATH contract.
# The external Docker volume dockhand_data is operational state, not an env var.
# =============================================================================


# =============================================================================
# 06 - STACK6 / Hermes + sandbox + memory maintenance
# =============================================================================
# Shared variables additionally used: STACKS_ROOT, BASE_PATH, NETWORK_NAME
# Consumers include:
#   01-prepare.sh                    base runtime/config/sandbox preparation
#   03-temporary-fix-...sh           temporary terminal timeout workaround
#   04-gitmem.sh                     Git-backed memory working tree
#   05-maintenance-sidecars.sh       memory-sync SSH + sandbox lifecycle state
#   docker-compose.yml               all Stack6 runtime services
#   Hermes runtime/config.yaml       model, MCP, web, messaging and API settings
# -----------------------------------------------------------------------------

# Local timezone.
# Used by: Stack6 scripts and runtime services.
# Secret: no. Lifecycle: configurable.
TZ=Europe/Madrid

# Persistent runtime service directory names below BASE_PATH.
# Used by: Stack6 scripts + Compose bind mounts.
# Secret: no. Lifecycle: fixed-default.
HERMES_SERVICE=service_-_hermes
HERMES_MEMORY_SERVICE=service_-_hermes-memory
MEMORY_SYNC_SERVICE=service_-_hermes-memory-sync
SANDBOX_SERVICE=service_-_hermes-sandbox

# Container names.
# Used by: Stack6 scripts + Compose lifecycle operations.
# Secret: no. Lifecycle: fixed-default.
HERMES_CONTAINER=hermes
MEMORY_SYNC_CONTAINER=hermes-memory-sync
SANDBOX_CONTAINER=hermes-sandbox
SANDBOX_CLEANUP_CONTAINER=hermes-sandbox-cleanup

# Images / exact Hermes release pinning.
# Used by: Stack6 prepare + Compose.
# Secret: no. Lifecycle: configurable; Hermes version must never be latest.
HERMES_IMAGE=nousresearch/hermes-agent
HERMES_VERSION=v2026.8.31
SANDBOX_IMAGE=hermes-sandbox:local
MEMORY_SYNC_IMAGE=hermes-memory-sync:local
SANDBOX_CLEANUP_IMAGE=hermes-sandbox-cleanup:local

# Numeric identities used for persistent filesystem ownership.
# Used by: Stack6 prepare, gitmem, maintenance and Compose.
# Secret: no. Lifecycle: fixed-default unless deployment UID/GID changes.
HERMES_UID=10000
HERMES_GID=10000
SANDBOX_UID=1000
SANDBOX_GID=1000

# Hermes model routing through LiteLLM.
# HERMES_MODEL is rendered into managed Hermes config by 01-prepare.sh.
# LITELLM_API_KEY is the dedicated model-inference credential for Hermes; it is
# separate from the MCP credential below.
# Secret: LITELLM_API_KEY yes; endpoint/model no.
# Lifecycle: model configurable; key operator-supplied/persistent.
HERMES_MODEL=mlx/local-agent
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=PUT_YOUR_LITELLM_API_KEY_HERE

# Hermes MCP access through the single LiteLLM MCP gateway.
# Used by: Stack6 prepare + Hermes managed config/runtime.
# Secret: LITELLM_MCP_API_KEY yes; URL no.
# Lifecycle: dedicated key operator-supplied/persistent.
LITELLM_MCP_URL=http://litellm:4000/mcp
LITELLM_MCP_API_KEY=PUT_YOUR_HERMES_MCP_API_KEY_HERE

# Optional Telegram bot credential. When empty, Telegram remains disabled and
# Hermes can run through its API/dashboard without a messaging platform.
# Used by: Stack6 prepare validation + Hermes runtime.
# Secret: yes. Lifecycle: operator-supplied/optional (BotFather).
TELEGRAM_BOT_TOKEN=

# Optional Buzz messaging integration. Leave all values empty to keep Buzz
# disabled. When enabled, BUZZ_RELAY_URL and BUZZ_PRIVATE_KEY are required by
# Hermes; BUZZ_CLI_PATH and BUZZ_AUTH_TAG remain optional.
# Used by: Stack6 Compose/Hermes runtime.
# Secret: BUZZ_PRIVATE_KEY and BUZZ_AUTH_TAG contain sensitive auth material.
# Lifecycle: operator-supplied/optional.
BUZZ_CLI_PATH=
BUZZ_RELAY_URL=
BUZZ_AUTH_TAG=
BUZZ_PRIVATE_KEY=

# Git-backed Hermes long-term memory.
# Used by: 04-gitmem.sh, memory bind mount, hermes-memory-sync sidecar.
# Credentials are deliberately external to .env and live in dedicated SSH
# material under the runtime tree.
# Secret: repository URL should not embed credentials; remaining values no.
# Lifecycle: repository operator-supplied, branch configurable.
GITMEM_REPOSITORY=PUT_YOUR_GITEA_REPOSITORY_URL_HERE
GITMEM_BRANCH=main
MEMORY_SYNC_INTERVAL_SECONDS=900

# Hermes dashboard and HTTP basic-auth settings.
# Used by: Stack6 Compose/Hermes runtime.
# Secret: password hash and auth secret yes; username/TTL no.
# Lifecycle: auth material generated-once/persistent.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=PUT_YOUR_PASSWORD_HASH_HERE
HERMES_DASHBOARD_BASIC_AUTH_SECRET=PUT_YOUR_SECRET_HERE
HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS=43200

# Hermes Runs/API server.
# Used by: Stack6 Compose/Hermes runtime.
# Secret: API_SERVER_KEY yes; remaining values no.
# Lifecycle: key generated-once/persistent, other settings configurable.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=PUT_YOUR_API_SERVER_KEY_HERE
API_SERVER_MODEL_NAME=hermes-agent
API_SERVER_CORS_ORIGINS=https://agentia.casa.lan

# Local web/search backends reached through redlocal.
# FIRECRAWL_API_KEY is intentionally empty in the current local deployment
# because Firecrawl authentication is disabled.
# Used by: Hermes web tools/runtime.
# Secret: FIRECRAWL_API_KEY only if enabled in a future deployment.
# Lifecycle: URLs fixed-default; key optional.
SEARXNG_URL=http://searxng:8080
FIRECRAWL_API_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=

# SSH execution path Hermes -> isolated sandbox.
# Used by: Stack6 prepare, Compose and Hermes terminal tool.
# The key path points to the private execution key inside Hermes; the actual key
# material is runtime state and must never be stored in this env file.
# Secret: no values here are the key itself.
# Lifecycle: fixed-default; TERMINAL_TIMEOUT is temporary workaround-sensitive.
TERMINAL_SSH_HOST=hermes-sandbox
TERMINAL_SSH_USER=agent
TERMINAL_SSH_PORT=2222
TERMINAL_SSH_KEY=/opt/data/ssh/hermes_executor_ed25519
TERMINAL_SSH_PERSISTENT=true
TERMINAL_TIMEOUT=300

# Sandbox resource limits.
# Used by: Stack6 docker-compose.yml.
# Secret: no. Lifecycle: configurable.
SANDBOX_CPU=2.0
SANDBOX_MEMORY=4g
SANDBOX_PIDS=256
SANDBOX_SHM_SIZE=512m

# Sandbox scratch lifecycle policy.
# Used by: hermes-sandbox-cleanup sidecar.
# Anything needed beyond this retention window must be persisted elsewhere.
# Secret: no. Lifecycle: configurable.
SANDBOX_CLEANUP_RETENTION_DAYS=7
SANDBOX_CLEANUP_QUARANTINE_DAYS=1
SANDBOX_CLEANUP_DB_RETENTION_DAYS=90
SANDBOX_CLEANUP_SWEEP_HOUR=3
SANDBOX_CLEANUP_SWEEP_MINUTE=30
