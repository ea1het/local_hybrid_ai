{
  "schema_version": 1,
  "id": 0,
  "directory": "stack0_-_platform",
  "name": "Platform foundation",
  "kind": "foundation",
  "atomic": true,
  "requires": [],
  "target_requires": [],
  "optional": [],
  "provides": [
    "platform.foundation",
    "platform.environment",
    "platform.network",
    "platform.pki"
  ],
  "owns": [
    "root:.env",
    "stack:.env-symlinks",
    "docker-network:redlocal",
    "runtime:service_-_platform"
  ],
  "components": [
    {
      "id": "platform-foundation",
      "management": {"type": "platform"},
      "upgrade": {
        "availability": "n/a",
        "selectable": false,
        "default_policy": "manual",
        "execution": {"mode": "not-applicable", "blocked_by": "non-versioned-component"}
      }
    }
  ],
  "blockers": [],
  "recovery": {
    "contract": {
      "schema_version": 1,
      "mode": "mixed"
    },
    "resources": [
      {
        "id": "platform-pki",
        "class": "persistent-identity",
        "strategy": "archive",
        "sensitive": true,
        "config": {
          "source": {
            "type": "runtime-path",
            "path": "${BASE_PATH}/service_-_platform/pki"
          },
          "restore": {
            "phase": "pre-prepare"
          }
        }
      }
    ]
  }
}
