# =============================================================================
# Stack3 - LiteLLM
# =============================================================================
# Stack-local configuration template.
# Shared deployment variables are intentionally kept first for compatibility
# with a future top-level installer/variable loader.

# -----------------------------------------------------------------------------
# Shared deployment context
# -----------------------------------------------------------------------------
STACKS_ROOT=/opt/docker/stacks
BASE_PATH=/opt/docker/runtime

# -----------------------------------------------------------------------------
# Image pinning
# -----------------------------------------------------------------------------
LITELLM_IMAGE=ghcr.io/berriai/litellm-database
LITELLM_VERSION=1.99.1

# -----------------------------------------------------------------------------
# LiteLLM application security and UI
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=PUT_YOUR_MASTER_KEY_HERE
LITELLM_SALT_KEY=PUT_YOUR_SALT_KEY_HERE
UI_USERNAME=admin
UI_PASSWORD=PUT_YOUR_PASSWORD_HERE
STORE_MODEL_IN_DB=True

# -----------------------------------------------------------------------------
# LiteLLM database connection
# PostgreSQL is provided by the shared Firecrawl PostgreSQL service.
# -----------------------------------------------------------------------------
POSTGRES_HOST=firecrawl-postgres
POSTGRES_PORT=5432
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=PUT_YOUR_PASSWORD_HERE
