# =============================================================================
# Stack3 - LiteLLM
# =============================================================================

BASE_PATH=/opt/docker

# -----------------------------------------------------------------------------
# Image pinning
# -----------------------------------------------------------------------------
# Keep image and human-readable version separate. Do not use :latest here.
LITELLM_IMAGE=ghcr.io/berriai/litellm-database
LITELLM_VERSION=1.99.1

# LiteLLM
LITELLM_MASTER_KEY=PUT_YOUR_MASTER_KEY_HERE
LITELLM_SALT_KEY=PUT_YOUR_SALT_KEY_HERE
UI_USERNAME=admin
UI_PASSWORD=PUT_YOUR_PASSWORD_HERE
STORE_MODEL_IN_DB=True

# PostgreSQL compartido fisicamente con Stack2, pero con identidad propia.
POSTGRES_HOST=firecrawl-postgres
POSTGRES_PORT=5432
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=PUT_YOUR_PASSWORD_HERE
