# =============================================================================
# Stack1 - HAProxy + Web
# =============================================================================
# Stack-local configuration template.
# Shared deployment variables are intentionally kept first so a future
# top-level installer/variable loader can reuse them without changing the
# current per-stack contract.

# -----------------------------------------------------------------------------
# Shared deployment context
# -----------------------------------------------------------------------------
STACKS_ROOT=/opt/docker/stacks
BASE_PATH=/opt/docker/runtime

# -----------------------------------------------------------------------------
# Ingress listeners and root domain
# -----------------------------------------------------------------------------
HAPROXY_HTTP_PORT=80
HAPROXY_HTTPS_PORT=443
ROOT_HOSTNAME=casa.lan

# -----------------------------------------------------------------------------
# Routed services
# Keep hostname/target pairs together for predictable generation and auditing.
# -----------------------------------------------------------------------------
WEB_TARGET=web:80

SEARCH_HOSTNAME=buscar
SEARCH_TARGET=searxng:8080

CHAT_HOSTNAME=chat
CHAT_TARGET=open-webui:8080

GIT_HOSTNAME=git
GIT_TARGET=gitea:3000

GWIA_HOSTNAME=gwia
GWIA_TARGET=litellm:4000

HOMELAB_HOSTNAME=homelab
HOMELAB_TARGET=dockhand:3000

AGENTIA_HOSTNAME=agentia
AGENTIA_TARGET=hermes:9119
