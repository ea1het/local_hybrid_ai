# =============================================================================
# Stack6 - Hermes Agent + isolated SSH sandbox
# =============================================================================

# -----------------------------------------------------------------------------
# Paths / naming
# -----------------------------------------------------------------------------
STACKS_ROOT=/opt/docker/stacks
BASE_PATH=/opt/docker/runtime
NETWORK_NAME=redlocal
TZ=Europe/Madrid

HERMES_SERVICE=service_-_hermes
HERMES_MEMORY_SERVICE=service_-_hermes-memory
MEMORY_SYNC_SERVICE=service_-_hermes-memory-sync
SANDBOX_SERVICE=service_-_hermes-sandbox
SANDBOX_CLEANUP_SERVICE=service_-_hermes-sandbox-cleanup

HERMES_CONTAINER=hermes
MEMORY_SYNC_CONTAINER=hermes-memory-sync
SANDBOX_CONTAINER=hermes-sandbox
SANDBOX_CLEANUP_CONTAINER=hermes-sandbox-cleanup

# -----------------------------------------------------------------------------
# Images
# -----------------------------------------------------------------------------
HERMES_IMAGE=nousresearch/hermes-agent
HERMES_VERSION=v2026.8.31
SANDBOX_IMAGE=hermes-sandbox:local
MEMORY_SYNC_IMAGE=hermes-memory-sync:local
SANDBOX_CLEANUP_IMAGE=hermes-sandbox-cleanup:local

# -----------------------------------------------------------------------------
# Hermes runtime UID/GID
# -----------------------------------------------------------------------------
HERMES_UID=10000
HERMES_GID=10000

# -----------------------------------------------------------------------------
# LiteLLM - model gateway
# -----------------------------------------------------------------------------
HERMES_MODEL=mlx/local-agent
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=PUT_YOUR_LITELLM_API_KEY_HERE

# -----------------------------------------------------------------------------
# LiteLLM - MCP gateway
# -----------------------------------------------------------------------------
LITELLM_MCP_URL=http://litellm:4000/mcp
LITELLM_MCP_API_KEY=PUT_YOUR_HERMES_MCP_API_KEY_HERE

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

# -----------------------------------------------------------------------------
# Git-backed Hermes memory
# -----------------------------------------------------------------------------
GITMEM_REPOSITORY=PUT_YOUR_GITEA_REPOSITORY_URL_HERE
GITMEM_BRANCH=main
MEMORY_SYNC_INTERVAL_SECONDS=900

# -----------------------------------------------------------------------------
# Hermes API / dashboard
# -----------------------------------------------------------------------------
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0

HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=PUT_YOUR_PASSWORD_HASH_HERE
HERMES_DASHBOARD_BASIC_AUTH_SECRET=PUT_YOUR_SECRET_HERE
HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS=43200

API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=PUT_YOUR_API_SERVER_KEY_HERE
API_SERVER_MODEL_NAME=hermes-agent
API_SERVER_CORS_ORIGINS=https://agentia.casa.lan

# -----------------------------------------------------------------------------
# Web tools
# -----------------------------------------------------------------------------
SEARXNG_URL=http://searxng:8080
FIRECRAWL_API_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# BUZZ.XYZ
# -----------------------------------------------------------------------------
BUZZ_CLI_PATH=/opt/data/bin/buzz
BUZZ_RELAY_URL=https://ea1het.communities.buzz.xyz
BUZZ_AUTH_TAG='["auth","...","","..."]'
BUZZ_PRIVATE_KEY=PUT_YOUR_BUZZ_PRIVATE_KEY_HERE

# -----------------------------------------------------------------------------
# SSH execution backend: Hermes -> sandbox
# -----------------------------------------------------------------------------
TERMINAL_SSH_HOST=hermes-sandbox
TERMINAL_SSH_USER=agent
TERMINAL_SSH_PORT=2222
TERMINAL_SSH_KEY=/opt/data/ssh/hermes_executor_ed25519
TERMINAL_SSH_PERSISTENT=true
TERMINAL_TIMEOUT=300

# -----------------------------------------------------------------------------
# Sandbox
# -----------------------------------------------------------------------------
SANDBOX_UID=1000
SANDBOX_GID=1000
SANDBOX_CPU=2.0
SANDBOX_MEMORY=4g
SANDBOX_PIDS=256
SANDBOX_SHM_SIZE=512m

# Scratch lifecycle. Anything needed long-term must be persisted outside sandbox.
SANDBOX_CLEANUP_RETENTION_DAYS=7
SANDBOX_CLEANUP_QUARANTINE_DAYS=1
SANDBOX_CLEANUP_DB_RETENTION_DAYS=90
SANDBOX_CLEANUP_SWEEP_HOUR=3
SANDBOX_CLEANUP_SWEEP_MINUTE=30
