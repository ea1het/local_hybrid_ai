{
  "schema_version": 1,
  "id": 6,
  "directory": "stack6_-_hermes",
  "name": "Hermes agent platform",
  "kind": "application",
  "atomic": true,
  "requires": [0, 3],
  "target_requires": [0, 3],
  "optional": [2, 4],
  "provides": ["ai.agent", "ai.sandbox", "ai.memory"],
  "consumes": ["ai.gateway", "ai.mcp-gateway"],
  "optional_consumes": ["web.search", "web.extract", "git.remote"],
  "owns": [
    "container:hermes",
    "container:hermes-sandbox",
    "container:hermes-memory-sync",
    "container:hermes-sandbox-cleanup",
    "runtime:service_-_hermes",
    "runtime:service_-_hermes-memory",
    "runtime:service_-_hermes-memory-sync",
    "runtime:service_-_hermes-sandbox"
  ],
  "components": [
    {
      "id": "hermes",
      "service": "hermes",
      "container": "hermes",
      "management": {"type": "versioned"},
      "upgrade": {
        "upstream": "NousResearch/hermes-agent",
        "default_policy": "major-series",
        "recovery_required": false,
        "execution": {"mode": "guarded", "blocked_by": null},
        "apply": {
          "type": "env-version",
          "env_key": "HERMES_VERSION",
          "image_env_key": "HERMES_IMAGE",
          "deploy": ["docker", "compose", "up", "-d", "hermes"]
        }
      }
    },
    {
      "id": "sandbox",
      "service": "hermes-sandbox",
      "container": "hermes-sandbox",
      "management": {"type": "local"},
      "upgrade": {
        "availability": "local",
        "selectable": false,
        "default_policy": "manual",
        "execution": {"mode": "inventory-only", "blocked_by": "local-build"}
      }
    },
    {
      "id": "memory-sync",
      "service": "hermes-memory-sync",
      "container": "hermes-memory-sync",
      "management": {"type": "local"}
    },
    {
      "id": "sandbox-cleanup",
      "service": "hermes-sandbox-cleanup",
      "container": "hermes-sandbox-cleanup",
      "management": {"type": "helper"}
    }
  ],
  "blockers": [],
  "recovery": {
    "contract": {
      "schema_version": 1,
      "mode": "reconstructable"
    },
    "resources": [
      {
        "id": "hermes-knowledge",
        "class": "externalized",
        "strategy": "git",
        "sensitive": false,
        "config": {
          "source": {
            "type": "git",
            "repository_env": "GITMEM_REPOSITORY"
          }
        }
      }
    ]
  }
}
