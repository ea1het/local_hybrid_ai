# =============================================================================
# Stack5 - Dockhand
# =============================================================================
# Stack-local configuration template.
# This stack currently needs only the shared deployment paths. Keeping these
# variables in the same leading section as the other stacks makes future
# central loading possible without changing the current per-stack workflow.

# -----------------------------------------------------------------------------
# Shared deployment context
# -----------------------------------------------------------------------------
STACKS_ROOT=/opt/docker/stacks
BASE_PATH=/opt/docker/runtime
