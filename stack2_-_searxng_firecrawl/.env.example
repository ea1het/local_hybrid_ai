# =============================================================================
# Stack2 - SearXNG + Firecrawl
# =============================================================================

STACKS_ROOT=/opt/docker/stacks
BASE_PATH=/opt/docker/runtime

# SearXNG se publica exclusivamente a traves de HAProxy.
SEARXNG_SECRET=PUT_YOUR_SECRET_HERE
SEARXNG_BASE_URL=https://buscar.casa.lan/

# Redis de Firecrawl.
REDIS_PASSWORD=PUT_YOUR_PASSWORD_HERE

# RabbitMQ de Firecrawl.
RABBITMQ_USER=firecrawl
RABBITMQ_PASSWORD=PUT_YOUR_PASSWORD_HERE

# PostgreSQL / NuQ de Firecrawl.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PUT_YOUR_PASSWORD_HERE
POSTGRES_DB=postgres
