"""Dispatch a stack command to the matching wrapper/bin Python entry point.

The executable name omits the wrapper's .py suffix. Arguments after the name
are passed through unchanged, so each stack wrapper retains ownership of its
own verbs, options, output, and exit status. A root-level --headless flag
suppresses the customizable banner without reaching stack wrappers. The
completion command emits Bash or Zsh integration for supported verbs and options, installs
it where the shell autoloads completions, and verifies that a login shell
actually activates it. Installation never edits shell startup files.
"""

from __future__ import annotations

import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True

from version import __version__
from wrapper.stubs.header import render_header

SCRIPT = Path(__file__).resolve()
BIN_DIR = SCRIPT.parent / "wrapper" / "bin"
STACK_VERBS = ("install", "start", "stop", "status", "reconfig")
HELP_OPTIONS = ("-h", "--help")
COMPLETION_SHELLS = ("bash", "zsh")
COMPLETION_ACTIONS = ("install", "status")
COMPLETION_FUNCTION = "_local_ai_complete"
ZSH_AUTOLOAD_FUNCTION = "_local-ai"
PROBE_TIMEOUT = 20
GENERATED_NOTE = "# Generated by local-ai completion {shell} install; reinstall instead of editing."

BASH_COMPLETION_BODY = r'''    local current="${COMP_WORDS[COMP_CWORD]}"
    local candidates
    candidates="$("${COMP_WORDS[0]}" __complete "${COMP_WORDS[@]:1:COMP_CWORD}")"
    COMPREPLY=($(compgen -W "$candidates" -- "$current"))'''

ZSH_COMPLETION_BODY = r'''    local -a candidates
    candidates=("${(@f)$("${words[1]}" __complete "${(@)words[2,CURRENT]}")}")
    compadd -- ${candidates:#}'''


def completion_names() -> list[str]:
    """Name the command spellings that should trigger completion."""
    names = ["local-ai", "./local-ai"]
    if not any(character.isspace() for character in str(SCRIPT)):
        names.append(str(SCRIPT))
    return names


def completion_script(shell: str, installed: bool = False) -> str:
    """Render the eval-able script, or the file form the shell autoloads."""
    names = " ".join(shlex.quote(name) for name in completion_names())
    note = GENERATED_NOTE.format(shell=shell)
    if shell == "bash":
        header = f"{note}\n" if installed else ""
        return (f"{header}{COMPLETION_FUNCTION}() {{\n{BASH_COMPLETION_BODY}\n}}\n"
                f"complete -F {COMPLETION_FUNCTION} {names}\n")
    if installed:
        # compinit reads the #compdef line, then autoloads the file body as the function.
        body = "\n".join(line.removeprefix("    ") for line in ZSH_COMPLETION_BODY.splitlines())
        return f"#compdef {names}\n{note}\n\n{body}\n"
    return (f"{COMPLETION_FUNCTION}() {{\n{ZSH_COMPLETION_BODY}\n}}\n"
            f"compdef {COMPLETION_FUNCTION} {names}\n")


def completion_target(shell: str) -> Path:
    """Choose the directory each shell searches for completions, per scope."""
    filename = ZSH_AUTOLOAD_FUNCTION if shell == "zsh" else "local-ai"
    override = os.environ.get("LOCAL_AI_COMPLETION_DIR")
    if override:
        return Path(override) / filename
    if os.geteuid() == 0:
        system = "zsh/site-functions" if shell == "zsh" else "bash-completion/completions"
        return Path("/usr/local/share") / system / filename
    data = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")
    if shell == "zsh":
        return data / "zsh" / "site-functions" / filename
    user_dir = Path(os.environ.get("BASH_COMPLETION_USER_DIR") or data / "bash-completion")
    return user_dir / "completions" / filename


PROBE_SCRIPTS = {
    "zsh": 'print -r -- "__LAI_COMPINIT__$+functions[compdef]"; '
           'print -r -- "__LAI_ACTIVE__${_comps[local-ai]}"; '
           'for d in $fpath; do print -r -- "__LAI_FPATH__$d"; done',
    "bash": 'type -t _completion_loader >/dev/null && echo __LAI_LOADER__1; '
            '_completion_loader local-ai >/dev/null 2>&1; '
            'echo "__LAI_ACTIVE__$(complete -p local-ai 2>/dev/null)"',
}


def probe_shell(shell: str) -> dict[str, list[str]] | str:
    """Ask a login interactive shell, like an SSH session, what it loads."""
    executable = shutil.which(shell)
    if executable is None:
        return f"{shell} is not installed, so activation cannot be verified"
    try:
        result = subprocess.run([executable, "-l", "-i", "-c", PROBE_SCRIPTS[shell]],
                                stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                timeout=PROBE_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        return f"interactive {shell} did not finish within {PROBE_TIMEOUT}s"
    facts: dict[str, list[str]] = {}
    for line in result.stdout.splitlines():
        if line.startswith("__LAI_") and "__" in line[6:]:
            key, _, value = line[6:].partition("__")
            facts.setdefault(key, []).append(value)
    if not facts:
        return f"interactive {shell} produced no probe output (exit {result.returncode})"
    return facts


def file_check(shell: str, target: Path) -> tuple[bool, str, str]:
    """Compare the installed file with what this checkout would install."""
    if not target.is_file():
        return False, "missing", f"run: ./local-ai completion {shell} install"
    try:
        current = target.read_text() == completion_script(shell, installed=True)
    except OSError as error:
        return False, f"unreadable ({error.strerror})", "check the file permissions"
    if not current:
        return False, "outdated or edited", f"run: ./local-ai completion {shell} install"
    return True, "installed and current", ""


def activation_checks(shell: str, target: Path,
                      facts: dict[str, list[str]]) -> list[tuple[str, bool, str, str]]:
    """Explain each condition the shell needs before TAB reaches local-ai."""
    active = (facts.get("ACTIVE") or [""])[0]
    if shell == "zsh":
        in_fpath = str(target.parent) in facts.get("FPATH", [])
        compinit = facts.get("COMPINIT") == ["1"]
        checks = [
            ("fpath", in_fpath, "directory is in $fpath" if in_fpath else "directory is not in $fpath",
             f"add 'fpath=({target.parent} $fpath)' to ~/.zshrc before compinit"),
            ("compinit", compinit, "enabled" if compinit else "not run by the startup files",
             "add 'autoload -Uz compinit && compinit' to ~/.zshrc"),
        ]
        from_file = active == ZSH_AUTOLOAD_FUNCTION
        stale_hint = ("the compinit cache predates the file: run "
                      "'rm -f ${ZDOTDIR:-$HOME}/.zcompdump*' and open a new shell")
    else:
        loader = facts.get("LOADER") == ["1"]
        checks = [
            ("loader", loader, "bash-completion is loaded" if loader else "bash-completion is not loaded",
             "install the bash-completion package and source it from ~/.bashrc"),
        ]
        # `complete -p` prints e.g. "complete -F _local_ai_complete local-ai".
        from_file = f"-F {COMPLETION_FUNCTION} " in active
        stale_hint = f"bash-completion did not find {target.name} in {target.parent}"
    if from_file:
        checks.append(("active", True, "local-ai completes from the installed file", ""))
    elif shell == "zsh" and active == COMPLETION_FUNCTION:
        checks.append(("active", True, "local-ai completes from an eval in a startup file", ""))
    else:
        detail = f"local-ai uses {active!r}" if active else "local-ai has no completion"
        prerequisites = all(ok for _, ok, _, _ in checks)
        checks.append(("active", False, detail,
                       stale_hint if prerequisites else "fix the checks above first"))
    return checks


def completion_status(shell: str) -> int:
    """Report the installed file and whether a new shell activates it."""
    target = completion_target(shell)
    checks = [("file", *file_check(shell, target))]
    facts = probe_shell(shell)
    if isinstance(facts, str):
        checks.append(("shell", False, facts, ""))
    else:
        checks.extend(activation_checks(shell, target, facts))
    scope = "system" if os.geteuid() == 0 and "LOCAL_AI_COMPLETION_DIR" not in os.environ else "user"
    print(f"{shell} completion ({scope}): {target}")
    for label, ok, detail, hint in checks:
        print(f"  {'[ok]' if ok else '[FAIL]':<6} {label:<9} {detail}")
        if not ok and hint:
            print(f"  {'':<6} {'':<9} -> {hint}")
    healthy = all(ok for _, ok, _, _ in checks)
    print(f"  {'active in new ' + shell + ' sessions' if healthy else 'needs attention'}")
    return 0 if healthy else 1


def install_completion(shell: str) -> int:
    """Write the completion file atomically and idempotently, then verify it."""
    target = completion_target(shell)
    content = completion_script(shell, installed=True)
    try:
        if target.is_file() and target.read_text() == content:
            print(f"Unchanged: {target}")
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            with tempfile.NamedTemporaryFile("w", dir=target.parent, prefix=".local-ai-",
                                             delete=False) as handle:
                handle.write(content)
            os.chmod(handle.name, 0o644)
            os.replace(handle.name, target)
            print(f"Installed: {target}")
    except OSError as error:
        print(f"Cannot install {target}: {error.strerror}", file=sys.stderr)
        return 1
    print()
    return completion_status(shell)


def available_commands() -> dict[str, Path]:
    """Find safe Python entry points in the wrapper binary directory."""
    return {
        path.stem: path
        for path in BIN_DIR.glob("*.py")
        if path.is_file() and not path.is_symlink() and not path.name.startswith("_")
    }


def completion_candidates(words: list[str], commands: dict[str, Path]) -> list[str]:
    """Return safe, current CLI names for the word being completed."""
    words = [word for word in words if word != "--headless"]
    if len(words) <= 1:
        return sorted((*commands, "completion", "--headless", *HELP_OPTIONS))
    command = words[0]
    if command == "completion":
        if len(words) == 2:
            return list(COMPLETION_SHELLS)
        return list(COMPLETION_ACTIONS) if len(words) == 3 and words[1] in COMPLETION_SHELLS else []
    if command not in commands:
        return []
    if len(words) == 2:
        verbs = ("bootstrap",) if command == "env" else (
            ("install", "status", "reconfig") if command == "stack-00" else STACK_VERBS
        )
        return [*verbs, "--headless", *HELP_OPTIONS]
    verb = words[1]
    if verb == "status" and command != "env":
        return [*HELP_OPTIONS, "--deep", "--headless"]
    if verb == "reconfig" and command != "env":
        return [*HELP_OPTIONS, "--apply", "--headless"]
    if (command == "env" and verb == "bootstrap") or (
        command == "stack-00" and verb == "install"
    ) or (command not in {"env", "stack-00"} and verb in STACK_VERBS):
        return [*HELP_OPTIONS, "--headless"]
    return []


def completion_command(arguments: list[str]) -> int:
    """Print, install, or verify the completion integration for one shell."""
    if len(arguments) == 1 and arguments[0] in COMPLETION_SHELLS:
        print(completion_script(arguments[0]), end="")
        return 0
    if len(arguments) == 2 and arguments[0] in COMPLETION_SHELLS and arguments[1] in COMPLETION_ACTIONS:
        if arguments[1] == "install":
            return install_completion(arguments[0])
        return completion_status(arguments[0])
    print("Usage: ./local-ai completion {bash,zsh} [install|status]", file=sys.stderr)
    return 2


def main(arguments: list[str] | None = None) -> int:
    """Dispatch a command and leave a blank line before returning to the shell."""
    arguments = sys.argv[1:] if arguments is None else arguments
    headless = "--headless" in arguments
    arguments = [argument for argument in arguments if argument != "--headless"]
    machine_output = bool(arguments and (arguments[0] == "__complete" or
                          (arguments[0] == "completion" and len(arguments) == 2 and
                           arguments[1] in COMPLETION_SHELLS)))
    try:
        if not headless and not machine_output:
            print(render_header(__version__), end="", flush=True)
        commands = available_commands()
        if arguments and arguments[0] == "__complete":
            print("\n".join(completion_candidates(arguments[1:], commands)))
            return 0
        if arguments and arguments[0] == "completion":
            return completion_command(arguments[1:])
        if not arguments or arguments[0] in {"-h", "--help"}:
            print("Usage: ./local-ai [--headless] <command> [parameters]", file=sys.stderr if not arguments else sys.stdout)
            print("Available commands: " + ", ".join(sorted((*commands, "completion"))),
                  file=sys.stderr if not arguments else sys.stdout)
            print("--headless suppresses the banner and may appear anywhere in the command.",
                  file=sys.stderr if not arguments else sys.stdout)
            return 2 if not arguments else 0

        command = arguments[0]
        if command not in commands:
            print(f"Unknown command: {command}", file=sys.stderr)
            print("Available commands: " + ", ".join(sorted((*commands, "completion"))), file=sys.stderr)
            return 2

        try:
            result = subprocess.run([sys.executable, "-B", str(commands[command]), *arguments[1:]],
                                    check=False)
        except KeyboardInterrupt:
            return 130
        return result.returncode if result.returncode >= 0 else 128 - result.returncode
    finally:
        if not machine_output:
            print(flush=True)


if __name__ == "__main__":
    raise SystemExit(main())
