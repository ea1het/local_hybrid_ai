"""Sole supported management entry point for local_hybrid_ai."""
import argparse
import sys

# The supported management CLI must not mutate the Git checkout merely by
# importing its private Python implementation.
sys.dont_write_bytecode = True

from commands import install_entry, upgrade_entry
from commands.cli import main
from commands.upgrade_guard import run_guarded


def _facade_help(argv: list[str]) -> bool:
    """Render help for facade-backed commands before their execution path."""
    semantic = [arg for arg in argv if arg not in {"--json", "--yes"}]
    if len(semantic) < 2 or semantic[-1] not in {"-h", "--help"}:
        return False
    command = semantic[0]
    if command == "install":
        install_entry.parser().print_help()
        return True
    if command == "upgrade":
        upgrade_entry.public_parser().print_help()
        return True
    if command == "completion":
        parser = argparse.ArgumentParser(
            prog="local-ai completion",
            description="Generate, install or inspect shell completion integration",
        )
        parser.add_argument("action", nargs="?", choices=("bash", "zsh", "install", "status"))
        parser.add_argument("--json", action="store_true", help="emit one machine-readable JSON document")
        parser.add_argument("--yes", action="store_true", help="grant consent when installing completion")
        parser.print_help()
        return True
    return False


def _interactive_facade_consent(argv: list[str]) -> list[str]:
    """Translate an interactive operator confirmation into global ``--yes``.

    JSON and non-interactive invocations never prompt; the structured facade
    then fails closed if consent is required.
    """
    if "--yes" in argv or "--json" in argv or not sys.stdin.isatty():
        return argv
    semantic = [arg for arg in argv if arg not in {"--json", "--yes"}]
    if not semantic:
        return argv
    command = semantic[0]
    mutation = False
    prompt = ""
    if command == "completion" and semantic[1:] == ["install"]:
        mutation = True
        prompt = "Install shell completion integration? [y/N] "
    elif command == "install" and not any(flag in semantic[1:] for flag in ("--plan", "--dry-run")):
        mutation = True
        prompt = "Execute the resolved stack installation/reconciliation plan? [y/N] "
    if not mutation:
        return argv
    try:
        answer = input(prompt)
    except EOFError:
        return argv
    return [*argv, "--yes"] if answer.strip().lower() in {"y", "yes"} else argv


if __name__ == "__main__":
    args = sys.argv[1:]
    if _facade_help(args):
        raise SystemExit(0)
    args = _interactive_facade_consent(args)
    raise SystemExit(run_guarded(args, main))
