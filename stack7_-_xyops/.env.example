# =============================================================================
# Stack7 - xyOps scheduler + dedicated xySat worker
# =============================================================================

# -----------------------------------------------------------------------------
# Global layout
# -----------------------------------------------------------------------------
STACKS_ROOT=/opt/docker/stacks
BASE_PATH=/opt/docker/runtime
NETWORK_NAME=redlocal
TZ=Europe/Madrid

# -----------------------------------------------------------------------------
# Runtime service directories
# -----------------------------------------------------------------------------
XYOPS_SERVICE=service_-_xyops
XYSAT_SERVICE=service_-_xysat
HERMES_MEMORY_SERVICE=service_-_hermes-memory
HERMES_SANDBOX_SERVICE=service_-_hermes-sandbox

# -----------------------------------------------------------------------------
# Containers
# -----------------------------------------------------------------------------
XYOPS_CONTAINER=xyops
XYSAT_CONTAINER=xysat

# -----------------------------------------------------------------------------
# Pinned upstream images
# -----------------------------------------------------------------------------
XYOPS_IMAGE=ghcr.io/pixlcore/xyops
XYOPS_VERSION=v1.0.96

XYSAT_IMAGE=ghcr.io/pixlcore/xysat
XYSAT_VERSION=v1.0.45

# -----------------------------------------------------------------------------
# xyOps conductor identity
#
# This must remain stable.  It will also become the HAProxy/DNS name.
# -----------------------------------------------------------------------------
XYOPS_HOSTNAME=xyops.casa.lan
XYOPS_MASTERS=xyops.casa.lan
XYOPS_BASE_APP_URL=https://xyops.casa.lan

# Local xySat embedded inside the conductor is deliberately disabled.

# Internal listeners.
XYOPS_HTTP_PORT=5522
XYOPS_HTTPS_PORT=5523

# -----------------------------------------------------------------------------
# xySat
#
# The actual bootstrap token/config is created later from the xyOps UI.
# No token belongs in this template or in Git.
# -----------------------------------------------------------------------------
XYSAT_CONFIG_FILE=/etc/xysat/config.json

